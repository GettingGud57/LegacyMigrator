{
  "legacy_sql": "legacy_jobs/insurance/MigrateStagedClaimData.sql",
  "database": "InsuranceDW",
  "proc": "Integration.MigrateStagedClaimData",
  "staging_script": "scripts/insurance/load_claim_staging.sql",
  "tables": [
    "Integration.Claim_Staging",
    "Integration.Lineage",
    "Integration.[ETL Cutoff]",
    "Dimension.Policy",
    "Dimension.Customer",
    "Dimension.Employee",
    "Fact.Claim"
  ],
  "batches": {
    "holdout": {
      "note": "September 2025",
      "staging_script": "scripts/insurance/load_claim_staging_holdout.sql"
    }
  },
  "keys": {
    "Integration.Claim_Staging": ["Claim Staging Key"],
    "Integration.Lineage": ["Lineage Key"],
    "Integration.ETL Cutoff": ["Table Name"],
    "Dimension.Policy": ["Policy Key"],
    "Dimension.Customer": ["Customer Key"],
    "Dimension.Employee": ["Employee Key"],
    "Fact.Claim": ["Source Claim Line ID"]
  },
  "ignore": {
    "Fact.Claim": {
      "Claim Key": "IDENTITY(1,1) column left out of the INSERT, so SQL Server numbers new rows itself and never rolls the counter back, so no rerun can match it"
    },
    "Integration.Lineage": {
      "Data Load Completed": "set to SYSDATETIME(), the clock time when the job ran (line 51)"
    }
  }
}
