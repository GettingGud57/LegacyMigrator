    ],
    "Integration.Lineage": [
      "Lineage Key"
    ],
    "Dimension.Customer": [
      "Customer Key"
    ],
    "Dimension.Payment Method": [
      "Payment Method Key"
    ],
    "Dimension.Supplier": [
      "Supplier Key"
    ],
    "Dimension.Transaction Type": [
      "Transaction Type Key"
    ],
    "Fact.Transaction": [
      "Transaction Key"
    ]
  },
  "ignore": {
    "Fact.Transaction": {
      "Transaction Key": "IDENTITY column left out of the INSERT, so SQL Server numbers new rows itself and never rolls the counter back, so no rerun can match it"
    },
    "Integration.Lineage": {
      "Data Load Completed": "set to SYSDATETIME(), the clock time when the job ran (line 65)"
    }
  }
