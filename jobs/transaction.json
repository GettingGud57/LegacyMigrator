{
  "legacy_sql": "legacy_jobs/wwi/MigrateStagedTransactionData.sql",
  "database": "WideWorldImportersDW",
  "proc": "Integration.MigrateStagedTransactionData",
  "staging_script": "scripts/load_transaction_staging.sql",
  "tables": [
    "Integration.[Transaction_Staging]",
    "Integration.[ETL Cutoff]",
    "Integration.[Lineage]",
    "Dimension.[Customer]",
    "Dimension.[Payment Method]",
    "Dimension.[Supplier]",
    "Dimension.[Transaction Type]",
    "Fact.[Transaction]"
  ],
  "batches": {
